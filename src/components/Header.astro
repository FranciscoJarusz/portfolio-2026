---
import RollText from '@/components/ui/RollText.jsx';
---

<header
    id="site-header"
    class="fixed top-0 left-0 right-0 z-50 py-6 px-30 bg-white"
>
    <div class="flex justify-between items-center">
        <a href="/">
            <img src="/logotipo.svg" alt="" class="w-30 h-auto" />
        </a>

        <div class="flex gap-18 items-center justify-center">
            <nav class="nav-link">
                <ul
                    class="flex gap-12 *:text-md *:text-grey *:hover:text-black *:transition-all *:duration-300"
                >
                    <li>
                        <a href="#hero"
                            ><RollText text="Inicio" client:load /></a
                        >
                    </li>
                    <li>
                        <a href="#experiencia"
                            ><RollText text="Experiencia" client:load /></a
                        >
                    </li>
                    <li>
                        <a href="#sobre-mi"
                            ><RollText text="Sobre mí" client:load /></a
                        >
                    </li>
                    <li>
                        <a href="#proyectos"
                            ><RollText text="Proyectos" client:load /></a
                        >
                    </li>
                </ul>
            </nav>
        </div>

        <a
            href="#"
            class="text-md font-bold py-2 px-7 text-black bg-yellow border-2 border-black shadow-brutal rounded-full bg-clip-padding"
            >CONTACTO</a
        >
    </div>
</header>
