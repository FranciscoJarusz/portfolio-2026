---
import RollText from '@/components/ui/RollText.jsx';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 py-6 px-30">
    <div
        class="flex justify-between items-center gap-8 py-3 pl-8 pr-3 rounded-full border-2 border-black bg-white bg-clip-padding shadow-brutal"
    >
        <a href="/">
            <img
                src="/logotipo.svg"
                alt="Imagotipo de Francisco Jarusz"
                class="w-30 h-auto scale-[0.984] hover:scale-102 active:scale-[0.951] transition-transform duration-300 will-change-transform backface-hidden"
            />
        </a>

        <div class="flex gap-18 items-center justify-center">
            <nav class="nav-link">
                <ul
                    class="flex gap-12 *:text-md *:text-black/75 *:hover:text-black *:transition-all *:duration-300"
                >
                    <li>
                        <a href="#hero" class="aria-[current]:text-black"
                            ><RollText text="Inicio" client:load /></a
                        >
                    </li>
                    <li>
                        <a href="#experiencia" class="aria-[current]:text-black"
                            ><RollText text="Experiencia" client:load /></a
                        >
                    </li>
                    <li>
                        <a href="#proyectos" class="aria-[current]:text-black"
                            ><RollText text="Proyectos" client:load /></a
                        >
                    </li>
                    <li>
                        <a href="#sobre-mi" class="aria-[current]:text-black"
                            ><RollText text="Sobre mí" client:load /></a
                        >
                    </li>
                </ul>
            </nav>
        </div>

        <a
            href="#contacto"
            class="text-md font-bold py-2 px-7 text-black bg-yellow border-2 border-black shadow-brutal-sm rounded-full bg-clip-padding hover:scale-102 active:scale-97 active:shadow-none transition-all duration-300"
            >CONTACTO</a
        >
    </div>
</header>
