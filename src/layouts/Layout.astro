---
import '@/styles/global.css';
import ClickSpark from '@/components/ClickSpark.astro';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import workSans from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';

const titulo = 'Francisco Jarusz - Desarrollador web y diseñador UX/UI';
const descripcion =
    'Francisco Jarusz, desarrollador web y diseñador UX/UI en Buenos Aires. Sitios y aplicaciones web con Astro, TypeScript y GSAP.';
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenOg = new URL('/og.png', Astro.site);

const persona = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Francisco Jarusz',
    alternateName: 'Fransz',
    url: Astro.site?.href,
    image: imagenOg.href,
    jobTitle: 'Desarrollador web y diseñador UX/UI',
    email: 'mailto:franszdev.web@gmail.com',
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'Buenos Aires',
        addressCountry: 'AR',
    },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'UADE' },
    sameAs: [
        'https://github.com/FranciscoJarusz',
        'https://www.linkedin.com/in/franciscojarusz/',
    ],
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={descripcion} />
        <link rel="canonical" href={canonica} />
        <meta name="theme-color" content="#f8f9fa" />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_AR" />
        <meta property="og:site_name" content="Fransz" />
        <meta property="og:url" content={canonica} />
        <meta property="og:title" content={titulo} />
        <meta property="og:description" content={descripcion} />
        <meta property="og:image" content={imagenOg} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Francisco Jarusz, desarrollador web y diseñador UX/UI"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={titulo} />
        <meta name="twitter:description" content={descripcion} />
        <meta name="twitter:image" content={imagenOg} />

        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(persona)}
        />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="48x48"
            href="/favicon-48.png"
        />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link
            rel="preload"
            href={bricolage}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href={workSans}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <title>{titulo}</title>
    </head>

    <body class="min-h-svh">
        <ClickSpark
            sparkColor="#1a1a1a"
            sparkSize={12}
            sparkRadius={22}
            sparkCount={8}
            duration={450}
        >
            <slot />
        </ClickSpark>
    </body>

    <script>
        import '@/scripts/lenis.ts';
        import '@/scripts/accent.ts';
    </script>
</html>
