---
import '../styles/global.css';
import ClickSpark from '@/components/ClickSpark.jsx';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <title>Fransz</title>
    </head>

    <body class="min-h-dvh">
        <ClickSpark
            sparkColor="#1a1a1a"
            sparkSize={12}
            sparkRadius={22}
            sparkCount={8}
            duration={450}
            client:load
        >
            <slot />
        </ClickSpark>
    </body>

    <script>
        import '@/scripts/lenis.ts';
        import '@/scripts/accent.ts';
    </script>
</html>
