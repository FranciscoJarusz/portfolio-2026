---
import '@/styles/global.css';
import ClickSpark from '@/components/ClickSpark.astro';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import workSans from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link
            rel="preload"
            href={bricolage}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href={workSans}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <title>Fransz</title>
    </head>

    <body class="min-h-dvh">
        <ClickSpark
            sparkColor="#1a1a1a"
            sparkSize={12}
            sparkRadius={22}
            sparkCount={8}
            duration={450}
        >
            <slot />
        </ClickSpark>
    </body>

    <script>
        import '@/scripts/lenis.ts';
        import '@/scripts/accent.ts';
    </script>
</html>
