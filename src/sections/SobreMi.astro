<script is:inline>
    (() => {
        const setHeaderHeight = () => {
            const header = document.getElementById('site-header');
            if (!header) return;
            document.documentElement.style.setProperty(
                '--header-h',
                header.getBoundingClientRect().height + 'px'
            );
        };
        setHeaderHeight();
        window.addEventListener('resize', setHeaderHeight);
        window.addEventListener('load', setHeaderHeight);
    })();
</script>

<section
    id="sobre-mi"
    data-accent="sky-blue"
    data-accent-antes="25"
    class="relative z-10 border-t-4 min-h-dvh border-black bg-sky-blue bg-[url('/fondo.svg')] bg-size-[100%_100%] max-xl:bg-cover bg-center bg-no-repeat px-(--gutter) py-10 flex flex-col gap-6 justify-center items-center"
>
    <h2
        data-sobre-title
        class="font-bold font-bricolage text-white text-5xl sm:text-7xl lg:text-8xl text-stroke-brutal text-shadow-brutal [--brutal-offset:0.052em] [--stroke-width:0.073em] mb-6 lg:mb-20 max-w-xl"
    >
        Sobre Mí
    </h2>

    <div class="flex min-h-[40dvh] w-full items-stretch gap-8 max-lg:flex-col lg:gap-15">
        <div
            data-sobre-foto
            class="shadow-brutal relative basis-1/2 2xl:basis-[40%] shrink-0 self-stretch overflow-hidden max-lg:basis-auto max-lg:aspect-square sm:max-lg:aspect-[4/3] rounded-3xl border-4 border-black"
        >
            <img
                src="/image.png"
                alt="Francisco Jarusz"
                class="absolute inset-0 h-full w-full object-cover"
            />
        </div>

        <div
            data-sobre-texto
            class="shadow-brutal relative flex flex-col justify-center rounded-3xl border-4 border-black bg-white px-6 py-8 sm:px-10 sm:py-15"
        >
            <div
                class="flex flex-col items-center justify-center h-full gap-6 text-base max-w-3xl"
            >
                <p>
                    ¡Hola! Soy Francisco Jarusz. Mi pasión por lo visual empezó
                    de chico, jugando con Photoshop, pero cuando descubrí la
                    programación supe que quería dedicarme a la tecnología.
                </p>
                <p>
                    Hoy, cursando el segundo año de la Licenciatura en Gestión
                    de Tecnología de la Información en la Univseridad Argentina
                    de la Empresa (UADE), encontré en el Front-end y el diseño
                    UX/UI el punto de equilibrio perfecto: el ecosistema donde
                    la creatividad y la lógica conviven sin tener que elegir
                    una.
                </p>
                <p>
                    Creo que los detalles no son un extra, son lo que define a
                    una buena experiencia. Esa atención es lo que hace que un
                    proyecto pase de sentirse simplemente bien, a sentirse
                    terminado. Esa última parte es la parte que más disfruto de
                    mi trabajo.
                </p>
            </div>
        </div>
    </div>
</section>

<script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';
    import { animarTitulo } from '@/scripts/titulo';

    gsap.registerPlugin(ScrollTrigger);

    const seccion = document.getElementById('sobre-mi');
    const titulo = seccion?.querySelector<HTMLElement>('[data-sobre-title]');
    const foto = seccion?.querySelector<HTMLElement>('[data-sobre-foto]');
    const texto = seccion?.querySelector<HTMLElement>('[data-sobre-texto]');

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        if (!seccion || !titulo || !foto || !texto) return;

        animarTitulo(titulo, { trigger: seccion, start: 'top 60%' });

        gsap.timeline({
            defaults: { duration: 1, ease: 'back.out(1.4)' },
            scrollTrigger: { trigger: foto, start: 'top 80%' },
        })
            .fromTo(
                foto,
                { autoAlpha: 0, x: -120, rotation: -4 },
                { autoAlpha: 1, x: 0, rotation: 0 }
            )
            .fromTo(
                texto,
                { autoAlpha: 0, x: 120, rotation: 4 },
                { autoAlpha: 1, x: 0, rotation: 0 },
                '<0.12'
            )
            .fromTo(
                texto.querySelectorAll('p'),
                { autoAlpha: 0, y: 24 },
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.6,
                    ease: 'power3.out',
                    stagger: 0.12,
                },
                '<0.35'
            );
    });
</script>
