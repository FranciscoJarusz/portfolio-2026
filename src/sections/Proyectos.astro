---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import proyectos from '@/data/proyectos.json';
import RollText from '@/components/ui/RollText.astro';
import FlechaDibujo from '@/components/ui/FlechaDibujo.astro';

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
    '/src/assets/projects/*.{png,jpg,jpeg,webp,avif}',
    { eager: true }
);
---

<script is:inline>
    (() => {
        const setHeaderHeight = () => {
            const header = document.getElementById('site-header');
            if (!header) return;
            const alto = header.getBoundingClientRect().height + 'px';
            const raiz = document.documentElement;
            if (raiz.style.getPropertyValue('--header-h') === alto) return;
            raiz.style.setProperty('--header-h', alto);
        };
        setHeaderHeight();
        window.addEventListener('resize', setHeaderHeight);
        window.addEventListener('load', setHeaderHeight);
    })();
</script>

<section
    id="proyectos"
    data-accent="yellow"
    class="z-0 bg-white px-(--gutter) py-10 flex flex-col gap-12 lg:gap-20 justify-center items-center"
>
    <h2
        data-proyectos-title
        class="font-bold font-bricolage text-yellow text-5xl sm:text-7xl lg:text-8xl text-stroke-brutal text-shadow-brutal [--brutal-offset:0.052em] [--stroke-width:0.073em] max-w-xl"
    >
        Proyectos
    </h2>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
        {
            proyectos.map((item) => {
                const imagen =
                    imagenes[`/src/assets/projects/${item.imagen}`]?.default;

                return (
                    <article data-proyecto class="border-3 shadow-brutal flex flex-col overflow-hidden rounded-3xl border-black bg-white">
                        <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group block overflow-hidden border-b-3 border-black"
                        >
                            {imagen && (
                                <Image
                                    src={imagen}
                                    alt={`Captura del sitio ${item.nombre}`}
                                    class="h-auto w-full transition-all duration-300 group-hover:scale-102"
                                />
                            )}
                        </a>

                        <div class="flex flex-col gap-5 p-5 sm:p-7">
                            <div class="flex flex-col gap-1.5">
                                <p class="text-sm uppercase opacity-75">
                                    {item.categoria}
                                </p>
                                <h3 class="font-bricolage text-2xl font-bold sm:text-3xl">
                                    {item.nombre}
                                </h3>
                            </div>

                            <p class="text-sm" set:html={item.descripcion} />

                            <div class="flex flex-col gap-7">
                                <ul class="flex flex-wrap gap-2">
                                    {item.tecnologias.map((tec) => (
                                        <li class="border-2 shadow-brutal-sm rounded-full border-black bg-clip-padding px-3 py-1 text-xs uppercase">
                                            {tec}
                                        </li>
                                    ))}
                                </ul>

                                <a
                                    href={item.url}
                                    class="text-md inline-flex w-fit items-center gap-4 text-black transition-all duration-300 active:scale-97"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <RollText text="Ver sitio" />
                                    <FlechaDibujo class="w-3" />
                                </a>
                            </div>
                        </div>
                    </article>
                );
            })
        }
    </div>
</section>

<script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';
    import '@/scripts/lenis';
    import { animarTitulo } from '@/scripts/titulo';
    import { MOVIL, aparecer } from '@/scripts/aparecer';

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector<HTMLElement>('#proyectos');
    const next = document.querySelector<HTMLElement>('#sobre-mi');
    const titulo = document.querySelector<HTMLElement>('[data-proyectos-title]');
    const cards = gsap.utils.toArray<HTMLElement>('[data-proyecto]');

    gsap.matchMedia().add(
        { movil: MOVIL, animar: '(prefers-reduced-motion: no-preference)' },
        ({ conditions }) => {
            if (!conditions?.animar) return;

            if (titulo) {
                animarTitulo(titulo, { trigger: titulo, start: 'top 80%' });
            }

            if (conditions.movil) {
                aparecer(cards);
                return;
            }

            gsap.set(cards, {
                autoAlpha: 0,
                y: 100,
                rotation: (i: number) => (i % 2 ? 3 : -3),
            });
            gsap.set(section?.querySelectorAll('[data-proyecto] li') ?? [], {
                scale: 0,
            });

            ScrollTrigger.batch(cards, {
                start: 'top 85%',
                once: true,
                onEnter: (batch) => {
                    gsap.to(batch, {
                        autoAlpha: 1,
                        y: 0,
                        rotation: 0,
                        duration: 1,
                        ease: 'back.out(1.4)',
                        stagger: 0.15,
                    });

                    gsap.to(
                        batch.flatMap((card) => [...card.querySelectorAll('li')]),
                        {
                            scale: 1,
                            duration: 0.5,
                            ease: 'back.out(2.5)',
                            stagger: 0.04,
                            delay: 0.5,
                        }
                    );
                },
            });
        }
    );

    if (section && next) {
        const mm = gsap.matchMedia();

        mm.add('(min-width: 1024px)', () => {
            ScrollTrigger.create({
                trigger: section,
                start: 'bottom bottom',
                end: () => `+=${next.offsetHeight}`,
                pin: true,
                pinSpacing: false,
                invalidateOnRefresh: true,
            });
        });
    }
</script>
