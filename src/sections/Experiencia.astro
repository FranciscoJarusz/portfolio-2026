---
import experiencia from '@/data/experiencia.json';
---

<script is:inline>
    (() => {
        const setHeaderHeight = () => {
            const header = document.getElementById('site-header');
            if (!header) return;
            document.documentElement.style.setProperty(
                '--header-h',
                header.getBoundingClientRect().height + 'px'
            );
        };
        setHeaderHeight();
        window.addEventListener('resize', setHeaderHeight);
        window.addEventListener('load', setHeaderHeight);
    })();
</script>

<section
    id="experiencia"
    data-accent="yellow"
    data-timeline
    class="relative pt-[calc(2.5rem+var(--header-h,88px))] pb-16 lg:h-dvh lg:overflow-hidden lg:pb-10"
>
    <div
        data-timeline-deco
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 max-lg:hidden"
    >
        <span
            data-deco
            data-entre="1"
            data-tramo="1"
            data-spin="-300"
            class="deco top-[35%] size-30"
        >
            <svg viewBox="-10 -10 909.81 906.89" class="size-full">
                <path
                    d="M446.02,716.92l-.41,169.97-445.53-.05-.05-257.8,1.85-17.21c14.04-90.23,74.99-157.37,161.7-185.95-6.37-1.5-11.34-.58-17.47-.59l-146.11-.42V1.78s247.65.47,247.65.47c23.52.04,44.71,7.42,66.67,14.12,41.83,15.88,79.85,40.54,106.58,76.33l13.76,18.42c10.45,14.83,17.23,31.17,24.99,47.75l.47-158.87,429.69.04-.22,226.5c-.01,13.11-3.08,24.54-4.81,37.32-17.41,78.75-79.82,143.99-156.79,167.19-.69,1.33-.71,1.85.98,1.88h160.83s0,453.85,0,453.85l-218.74.04c-4.79,0-8.63-1.96-13.22-.86l-27.43-4.89c-62.58-11.16-129.81-63.45-162.86-119.71-8.43-14.34-14.52-27.79-21.53-44.44Z"
                    fill="var(--color-yellow)"
                    stroke="var(--color-black)"
                    stroke-width="3"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"></path>
            </svg>
        </span>

        <span
            data-deco
            data-entre="0"
            data-tramo="1"
            data-spin="240"
            class="deco top-[79%] size-32"
        >
            <svg viewBox="-24 -8 528 528" class="size-full">
                <path
                    d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256 8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85z"
                    fill="var(--color-coral-pink)"
                    stroke="var(--color-black)"
                    stroke-width="3"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"></path>
            </svg>
        </span>
    </div>

    <div
        data-timeline-track
        class="relative flex flex-col gap-10 px-(--gutter) lg:h-full lg:w-max lg:flex-row lg:items-center lg:gap-64 lg:px-120"
    >
        <span
            data-timeline-line
            aria-hidden="true"
            class="absolute top-1/2 right-0 left-0 -mt-0.5 h-1 bg-black max-lg:hidden"></span>

        <div
            data-timeline-arrow
            aria-hidden="true"
            class="border-3 shadow-brutal-sm absolute top-1/2 -mt-5 right-120 grid size-10 place-items-center rounded-full border-black bg-white max-lg:hidden"
        >
            <img src="/arrow.svg" alt="" class="h-3.5 w-3.5" />
        </div>

        <h2
            data-timeline-title
            class="font-bold font-bricolage text-yellow text-5xl sm:text-7xl lg:text-8xl text-stroke-brutal text-shadow-brutal [--brutal-offset:5px] relative lg:absolute lg:top-[calc(6rem-var(--header-h,88px))] lg:left-(--gutter) z-20 max-w-xl"
        >
            Experiencia Laboral
        </h2>

        {
            experiencia.map((item, i) => {
                const arriba = i % 2 !== 0;
                const primero = i === 0;
                const ultimo = i === experiencia.length - 1;

                return (
                    <article
                        data-timeline-item
                        data-pos={arriba ? 'arriba' : 'abajo'}
                        class="relative pl-12 lg:h-full lg:w-190 lg:shrink-0 lg:pl-0"
                    >
                        <span
                            data-timeline-seg
                            aria-hidden="true"
                            class:list={[
                                'absolute left-4 w-1 bg-black lg:hidden',
                                primero ? 'top-10' : 'top-0',
                                ultimo ? 'bottom-0' : '-bottom-10',
                            ]}
                        />

                        <span
                            data-timeline-stem
                            aria-hidden="true"
                            class:list={[
                                'absolute top-10 left-4.5 h-1 w-7.5 bg-black lg:left-1/2 lg:-ml-0.5 lg:h-12 lg:w-1',
                                arriba ? 'lg:top-auto lg:bottom-1/2' : 'lg:top-1/2',
                            ]}
                        />

                        <span
                            data-timeline-dot
                            aria-hidden="true"
                            class="border-3 bg-lavander absolute top-8 left-2 z-10 size-5 rounded-full border-black lg:top-1/2 lg:left-1/2 lg:-mt-2.5 lg:-ml-2.5"
                        />

                        <div
                            class:list={[
                                'relative max-w-2xl lg:absolute lg:left-1/2 lg:w-170 lg:max-w-none lg:-translate-x-1/2',
                                arriba
                                    ? 'lg:bottom-[calc(50%+3rem)]'
                                    : 'lg:top-[calc(50%+3rem)]',
                            ]}
                        >
                            <div
                                data-timeline-card
                                class="border-3 shadow-brutal rounded-3xl border-black p-7 flex flex-col gap-3.5"
                                style={`background-color:${item.color};color:${item.colorTexto}`}
                                data-base={item.color}
                                data-activo={item.colorActivo}
                            >
                                <div class="flex flex-col gap-1.5">
                                    <div class="flex items-center justify-between gap-5">
                                        <h3 class="font-bricolage text-3xl max-w-sm font-bold">
                                            {item.cargo}
                                        </h3>
                                        {item.link && (
                                            <a
                                                href={item.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`Ver ${item.empresa}`}
                                                class="border-3 p-2 shadow-brutal [--brutal-offset:2px] group grid shrink-0 place-items-center rounded-full border-black transition-all duration-300 active:scale-95 active:shadow-none bg-clip-padding"
                                                style={`color:${item.colorBoton};background-color:${item.color}`}
                                            >
                                                <img
                                                    src="/arrow.svg"
                                                    alt="Flecha mirando hacia la derecha"
                                                    class="w-3 -rotate-45 transition-transform duration-300 group-hover:rotate-0"
                                                />
                                            </a>
                                        )}{' '}
                                    </div>
                                    <p class="text-lg">{item.empresa}</p>
                                    <p class="text-sm opacity-75">
                                        {item.fecha}
                                    </p>{' '}
                                </div>
                                <p
                                    class="text-sm"
                                    set:html={item.descripcion}
                                />
                            </div>
                        </div>
                    </article>
                );
            })
        }
    </div>
</section>

<style>
    .deco {
        position: absolute;
        display: block;
        translate: -50% -50%;
        pointer-events: none;
        will-change: transform;
        filter: drop-shadow(4px 4px 0 var(--color-black));
    }

    @media (prefers-reduced-motion: reduce) {
        .deco {
            display: none;
        }
    }
</style>
<script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';
    import '@/scripts/lenis';
    import { animarTitulo } from '@/scripts/titulo';

    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector<HTMLElement>('[data-timeline]');
    const track = document.querySelector<HTMLElement>('[data-timeline-track]');
    const line = document.querySelector<HTMLElement>('[data-timeline-line]');
    const title = document.querySelector<HTMLElement>('[data-timeline-title]');
    const arrow = document.querySelector<HTMLElement>('[data-timeline-arrow]');
    const star = document.querySelector<HTMLElement>('[data-hero-star]');
    const decos = Array.from(
        document.querySelectorAll<HTMLElement>('[data-deco]')
    );

    if (section && track && line) {
        const items = gsap.utils.toArray<HTMLElement>('[data-timeline-item]');

        const PUNTA = 0.62;

        const RAMPA = 300;

        const ENTRADA = 240;

        const DOT = 90;
        const STEM = 110;
        const CARD = 140;
        const DELAY_STEM = 30;
        const DELAY_CARD = 60;
        const COLA = 80;
        const FLECHA = 150;

        let ctx: gsap.Context | undefined;
        let ancho = window.innerWidth;

        const build = () => {
            ctx?.revert();
            ctx = undefined;

            if (window.innerWidth < 1024) {
                buildMovil();
                return;
            }

            ctx = gsap.context(() => {
                const anchoItem = items[0]?.offsetWidth ?? 0;
                const anchoCard =
                    items[items.length - 1]?.querySelector<HTMLElement>(
                        '[data-timeline-card]'
                    )?.offsetWidth ?? 0;

                const cierre = Math.max(
                    DELAY_CARD + CARD,
                    anchoCard / 2 + COLA + FLECHA
                );

                const punta = window.innerWidth * PUNTA;

                gsap.set(track, {
                    paddingLeft: punta - anchoItem / 2 + ENTRADA,
                    paddingRight: Math.max(
                        0,
                        window.innerWidth - punta - anchoItem / 2
                    ),
                });

                const largo = track.scrollWidth;
                const overflow = Math.max(0, largo - window.innerWidth);

                const inicio = line.offsetLeft;

                const centros = items.map(
                    (item) => item.offsetLeft + item.offsetWidth / 2
                );

                const ultimo = Math.max(...centros);

                const finLinea = ultimo + anchoCard / 2 + COLA;

                const total = ultimo + cierre;

                const largoPin = total - punta;
                const recorrido = Math.min(ultimo - punta, overflow);

                decos.forEach((deco) => {
                    const entre = Number(deco.dataset.entre ?? 0);
                    const desde = centros[entre] ?? 0;
                    const hasta = centros[entre + 1] ?? desde;
                    const tramo = Number(deco.dataset.tramo ?? 0.5);

                    gsap.set(deco, {
                        rotate: 0,
                        left: desde + (hasta - desde) * tramo,
                    });
                });

                const dibujado = (scroll: number) =>
                    scroll <= RAMPA
                        ? inicio + (scroll * (punta - inicio + RAMPA)) / RAMPA
                        : punta + scroll;

                const tl = gsap.timeline({
                    paused: true,
                    defaults: { ease: 'none' },
                });

                gsap.set(line, {
                    width: finLinea - inicio,
                    transformOrigin: 'left center',
                });
                tl.fromTo(
                    line,
                    { scaleX: 0 },
                    { scaleX: 1, duration: finLinea - inicio },
                    inicio
                );

                if (arrow) {
                    gsap.set(arrow, {
                        left: finLinea - 2,
                        transformOrigin: 'left center',
                    });
                    tl.fromTo(
                        arrow,
                        { scale: 0 },
                        {
                            scale: 1,
                            duration: FLECHA,
                            ease: 'back.out(2.2)',
                        },
                        finLinea
                    );
                }

                items.forEach((item, index) => {
                    const arriba = item.dataset.pos === 'arriba';
                    const dot = item.querySelector<HTMLElement>(
                        '[data-timeline-dot]'
                    );
                    const stem = item.querySelector<HTMLElement>(
                        '[data-timeline-stem]'
                    );
                    const card = item.querySelector<HTMLElement>(
                        '[data-timeline-card]'
                    );
                    if (!dot || !stem || !card) return;

                    const origen = arriba ? 'center bottom' : 'center top';
                    gsap.set(stem, { transformOrigin: origen });
                    gsap.set(card, { transformOrigin: origen });

                    const t = centros[index];

                    tl.fromTo(
                        dot,
                        { scale: 0 },
                        { scale: 1, duration: DOT, ease: 'back.out(2.4)' },
                        t
                    );

                    tl.fromTo(
                        stem,
                        { scaleY: 0 },
                        { scaleY: 1, duration: STEM, ease: 'power2.out' },
                        t + DELAY_STEM
                    );

                    tl.fromTo(
                        card,
                        { opacity: 0, scale: 0.94, y: arriba ? 48 : -48 },
                        {
                            opacity: 1,
                            scale: 1,
                            y: 0,
                            duration: CARD,
                            ease: 'power3.out',
                        },
                        t + DELAY_CARD
                    );

                    const activo = card.dataset.activo;
                    const base = card.dataset.base;
                    if (activo && base) {
                        tl.fromTo(
                            [card, dot],
                            { backgroundColor: base },
                            { backgroundColor: activo, duration: CARD },
                            t + DELAY_CARD
                        );

                        const siguiente = centros[index + 1];
                        const apagado =
                            siguiente !== undefined
                                ? siguiente + DELAY_CARD
                                : total - CARD;

                        tl.to(
                            [card, dot],
                            { backgroundColor: base, duration: CARD },
                            apagado
                        );
                    }
                });

                const aplicar = (self: ScrollTrigger) => {
                    const scroll = self.progress * largoPin;
                    const corrido = Math.min(scroll, recorrido);
                    tl.time(Math.min(dibujado(scroll), total));
                    gsap.set(track, { x: -corrido });

                    decos.forEach((deco) => {
                        gsap.set(deco, {
                            x: -corrido,
                            rotate:
                                self.progress * Number(deco.dataset.spin ?? 0),
                        });
                    });

                    if (star) {
                        gsap.set(star, { x: -corrido, y: scroll });
                    }
                };

                ScrollTrigger.create({
                    trigger: section,
                    start: 'top top',
                    end: `+=${largoPin}`,
                    pin: true,
                    onUpdate: aplicar,
                    onRefresh: aplicar,
                });

                if (title) {
                    animarTitulo(title, { trigger: section, start: 'top 70%' });
                }
            }, section);
        };

        const buildMovil = () => {
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            ctx = gsap.context(() => {
                if (title) {
                    animarTitulo(title, { trigger: title, start: 'top 85%' });
                }

                items.forEach((item) => {
                    const seg = item.querySelector('[data-timeline-seg]');
                    const dot = item.querySelector('[data-timeline-dot]');
                    const stem = item.querySelector('[data-timeline-stem]');
                    const card = item.querySelector('[data-timeline-card]');
                    if (!seg || !dot || !stem || !card) return;

                    gsap.timeline({
                        scrollTrigger: {
                            trigger: item,
                            start: 'top 85%',
                            once: true,
                        },
                    })
                        .fromTo(
                            seg,
                            { scaleY: 0, transformOrigin: 'center top' },
                            { scaleY: 1, duration: 0.9, ease: 'power2.inOut' }
                        )
                        .fromTo(
                            dot,
                            { scale: 0 },
                            { scale: 1, duration: 0.4, ease: 'back.out(2.4)' },
                            0
                        )
                        .fromTo(
                            stem,
                            { scaleX: 0, transformOrigin: 'left center' },
                            { scaleX: 1, duration: 0.3, ease: 'power2.out' },
                            0.15
                        )
                        .fromTo(
                            card,
                            { autoAlpha: 0, x: 40 },
                            {
                                autoAlpha: 1,
                                x: 0,
                                duration: 0.7,
                                ease: 'back.out(1.4)',
                            },
                            0.25
                        );
                });
            }, section);
        };

        build();

        let pendiente: number | undefined;
        window.addEventListener('resize', () => {
            if (pendiente) window.clearTimeout(pendiente);
            pendiente = window.setTimeout(() => {
                if (window.innerWidth === ancho) return;
                ancho = window.innerWidth;
                build();
            }, 250);
        });
    }
</script>
