---
import RollText from '@/components/ui/RollText.astro';

interface Props {
    etiqueta?: string;
    titulo?: string;
    texto?: string;
    botones?: { texto: string; href: string; color: string }[];
    tamanoTitulo?: string;
}

const {
    etiqueta = 'Desarrollador Web y Diseñador UX/UI',
    titulo = 'Francisco Jarusz',
    texto = 'Diseño y desarrollo sitios web a medida para negocios. Estudiante de la Licenciatura en Gestión de Tecnología de la Información en UADE, Buenos Aires. Apasionado por crear webs con identidad propia.',
    botones = [
        {
            texto: 'Trabajemos juntos',
            href: '#contacto',
            color: 'bg-soft-green',
        },
        { texto: 'Ver proyectos', href: '#proyectos', color: 'bg-coral-pink' },
    ],
    tamanoTitulo = 'text-5xl min-[400px]:text-6xl sm:text-8xl lg:text-9xl 2xl:text-[min(7.6vw,8rem)]',
} = Astro.props;
---

<script is:inline>
    history.scrollRestoration = 'manual';

    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const raiz = document.documentElement;
        raiz.classList.add('hero-intro');
        document.fonts.ready.then(() => raiz.classList.add('hero-fuentes'));
        setTimeout(() => raiz.classList.remove('hero-intro'), 4000);
    }
</script>

<section
    id="hero"
    data-accent="yellow"
    class="relative flex min-h-svh items-center px-(--gutter) pt-(--header-h,88px) max-2xl:pt-[calc(var(--header-h,88px)+2.5rem)] max-2xl:pb-16"
>
    <div
        data-hero-star
        data-hero-in
        class="pointer-events-none absolute top-[15dvh] right-[-34%] z-0 w-310 will-change-transform max-lg:top-auto max-lg:right-0 max-lg:bottom-0 max-lg:w-[90vw] max-lg:translate-x-[35%] max-lg:translate-y-[20%]"
        aria-hidden="true"
    >
        <svg
            data-hero-star-giro
            class="absolute inset-0 translate-3 will-change-transform"
            viewBox="-1 -1 244.59 228.56"
            fill="var(--color-black)"
            stroke="var(--color-black)"
        >
            <use href="#hero-star"></use>
        </svg>

        <svg
            data-hero-star-giro
            class="relative block w-full will-change-transform"
            viewBox="-1 -1 244.59 228.56"
            fill="var(--color-yellow)"
            stroke="var(--color-black)"
        >
            <path
                id="hero-star"
                d="M75.98,226.56l-50.89-36.95,66.92-62.74-.7-4.18L0,105.96l18.82-60.65,82.96,46.01,2.79-2.79L89.93,0h62.74l-14.64,88.53,3.49,2.79,82.26-46.01,18.82,60.65-90.62,16.73-.7,3.49,69.01,62.74-50.19,36.95-46.01-80.17h-4.18l-43.92,80.86Z"
                stroke-width="6"
                stroke-linejoin="miter"
                vector-effect="non-scaling-stroke"></path>
        </svg>
    </div>

    <div
        class="flex w-full justify-between items-center z-20 max-2xl:flex-col max-2xl:items-stretch max-2xl:gap-12"
    >
        <div class="flex flex-col gap-7">
            <div class="flex flex-col gap-3.5">
                <p
                    data-hero-in
                    style="--hero-delay: 0.2s"
                    class="text-sm text-black uppercase"
                >
                    {etiqueta}
                </p>

                <h1
                    data-hero-title
                    class:list={[
                        tamanoTitulo,
                        'font-bricolage max-w-[7em] leading-[0.85] font-extrabold text-black uppercase',
                    ]}
                >
                    {titulo}
                </h1>
            </div>

            <p
                data-hero-in
                style="--hero-delay: 0.9s"
                class="max-w-2xl text-lg text-black/75 max-sm:text-base"
            >
                {texto}
            </p>

            <div
                data-hero-in
                style="--hero-delay: 1.02s"
                class="flex flex-wrap items-center gap-6"
            >
                {
                    botones.map((boton) => (
                        <a
                            href={boton.href}
                            class:list={[
                                boton.color,
                                'shadow-brutal-sm rounded-button border-2 border-black bg-clip-padding px-7 py-2 text-sm font-bold text-black uppercase transition-all duration-300 hover:scale-102 active:scale-97 active:shadow-none',
                            ]}
                        >
                            <RollText text={boton.texto} />
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style is:global>
    .hero-intro [data-hero-title] {
        visibility: hidden;
    }

    .hero-intro [data-hero-in] {
        animation: hero-subir 0.7s cubic-bezier(0.215, 0.61, 0.355, 1)
            var(--hero-delay, 0s) backwards;
    }

    .hero-intro [data-hero-star] {
        animation: hero-estrella 1.4s cubic-bezier(0.34, 1.4, 0.64, 1) backwards;
    }

    .hero-intro:not(.hero-fuentes) [data-hero-in] {
        animation-play-state: paused;
    }

    @media (max-width: 63.99rem) {
        .hero-intro [data-hero-in],
        .hero-intro [data-hero-star] {
            animation-name: hero-aparecer;
            animation-duration: 0.7s;
            animation-timing-function: ease-out;
        }
    }

    @keyframes hero-aparecer {
        from {
            opacity: 0;
        }
    }

    @keyframes hero-subir {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
    }

    @keyframes hero-estrella {
        from {
            opacity: 0;
            transform: scale(0.6);
        }
    }
</style>

<script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';
    import { partirLetras } from '@/scripts/titulo';

    gsap.registerPlugin(ScrollTrigger);

    const raiz = document.documentElement;
    const giros = gsap.utils.toArray<SVGElement>('[data-hero-star-giro]');
    const titulo = document.querySelector<HTMLElement>('[data-hero-title]');

    const mm = gsap.matchMedia();

    mm.add(
        '(min-width: 64rem) and (prefers-reduced-motion: no-preference)',
        () => {
            gsap.to(giros, {
                rotation: () => ScrollTrigger.maxScroll(window) * 0.1,
                ease: 'none',
                scrollTrigger: {
                    start: 0,
                    end: 'max',
                    scrub: true,
                    invalidateOnRefresh: true,
                },
            });
        }
    );

    const entrada = async () => {
        if (!raiz.classList.contains('hero-intro') || !titulo) return;

        await document.fonts.ready;

        const columnas = [titulo.parentElement?.parentElement].filter(
            (el): el is HTMLElement => !!el
        );
        const anchos = columnas.map((el) =>
            parseFloat(getComputedStyle(el).width)
        );
        gsap.set(columnas, {
            flex: 'none',
            width: (i: number) => anchos[i],
            autoRound: false,
        });

        const split = partirLetras(titulo);

        gsap.set(titulo, { autoAlpha: 1 });

        gsap.timeline({
            defaults: { ease: 'power3.out' },
            onComplete: () => {
                split.revert();
                gsap.set(columnas, { clearProps: 'flex,width' });
            },
        }).fromTo(
            split.chars,
            { yPercent: 110 },
            {
                yPercent: 0,
                duration: 0.8,
                ease: 'power4.out',
                stagger: 0.035,
            },
            0.3
        );
    };

    entrada();
</script>
